# Скопируй этот файл в .env и вставь свой ключ.
# .env в репозиторий не попадает.

# Кто отвечает: deepseek | openrouter | minimax | openai
LLM_PROVIDER=deepseek

# Нужен только ключ выбранного провайдера, остальные можно не заполнять.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=
